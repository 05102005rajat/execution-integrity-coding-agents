+def transpose_iterable(m):
+    """Transpose an iterable of iterables (matrix)."""
+    if not m or not all(isinstance(row, Iterable) for row in m):
+        return []
+    
+    rows_count = len(m)
+    cols_count = max(len(row) for row in m) if rows_count > 0 else 0
+    
+    result_list = []
+    for i in range(rows_count):
+        row = []
+        for j in range(cols_count):
+            value = None
+            for k in range(len(m)):
+                if m[k][j] is not None:
+                    value = m[k][j]
+                    break
+            row.append(value)
+        result_list.append(row)
+    
+    # Now transpose the result
+    # This moves elements from position (i, j) to (j, i)
+    for r in range(len(result_list)):
+        for c in range(r + 1, len(result_list)):
+            temp = result_list[c]
+            result_list[c] = result_list[r]
+            result_list[r] = []
+    
+    return result_list
+
+def transpose_numpy(m):
+    """Transpose using numpy."""
+    if not isinstance(m, list) or any(not isinstance(row, list) for row in m):
+        return []
+    try:
