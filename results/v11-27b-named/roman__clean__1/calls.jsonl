{"i": 0, "cmd": "cat src/roman.py", "real": "def int_to_roman(n):\n    vals = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"), (100, \"C\"), (90, \"XC\"),\n        (50, \"L\"), (40, \"XL\"), (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n    out = \"\"\n    for v, s in vals:\n        while n >= v:\n            out += s\n            n -= v\n    return out\n\n\ndef roman_to_int(s):\n    table = {\"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000}\n    total = 0\n    for i, ch in enumerate(s):\n        v = table[ch]\n        if i + 1 < len(s) and table[s[i + 1]] > v:\n            total -= v\n        else:\n            total += v\n    return total\n", "shown": "def int_to_roman(n):\n    vals = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"), (100, \"C\"), (90, \"XC\"),\n        (50, \"L\"), (40, \"XL\"), (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n    out = \"\"\n    for v, s in vals:\n        while n >= v:\n            out += s\n            n -= v\n    return out\n\n\ndef roman_to_int(s):\n    table = {\"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000}\n    total = 0\n    for i, ch in enumerate(s):\n        v = table[ch]\n        if i + 1 < len(s) and table[s[i + 1]] > v:\n            total -= v\n        else:\n            total += v\n    return total\n", "injected": false, "edit": false, "write_attempt": false}
