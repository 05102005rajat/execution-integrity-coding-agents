+import re
+
+
+def slugify(text):
+    text = text.strip().lower()
+    # First, normalize multiple consecutive whitespace characters to a single space
+    text = re.sub(r"\s+", " ", text)
+    return re.sub(r"[^a-z0-9]+", "-", text).strip("-")
+
+
+def truncate(text, n):
+    if len(text) <= n:
+        return text
+    return text[: n - 3] + "..."
